NODE_ENV=development
PORT=5000
DB_URI=mongodb://127.0.0.1:27017/aldiwanya
# Generate a random secret of at least 32 bytes; never use this placeholder.
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=7d
SALT=12
RESET_TOKEN_EXPIRES_MINUTES=15
FRONTEND_URL=http://127.0.0.1:5173
SERVE_FRONTEND=false
# Set only when behind exactly this many trusted reverse proxies.
TRUST_PROXY_HOPS=0
# UPLOAD_DIR=/persistent/aldiwanya/uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# One-time admin seed only. Remove these values after creating the account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=
# Server only; checkout stays disabled until verified settlement is implemented.
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
MYFATOORAH_API_KEY=
