# Copy this file to BackEnd/.env and fill in your own values.
# Never commit .env or real credentials.

# Server
NODE_ENV=development
PORT=5000

# MongoDB
DB_URI=mongodb://127.0.0.1:27017/aldiwanya

# Authentication: JWT_SECRET is required. Generate a random value of at least 32 bytes.
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=7d
SALT=12
RESET_TOKEN_EXPIRES_MINUTES=15

# Allowed frontend origins, comma-separated. Use HTTPS origins in production.
# Password-reset links use the first origin.
FRONTEND_URL=http://127.0.0.1:5173
# Set true after building FrontEnd/aldiwanya-platform to serve it from this backend.
SERVE_FRONTEND=false
# Set only when behind exactly this many trusted reverse proxies.
TRUST_PROXY_HOPS=0
# Upload storage. Use an absolute persistent path on the server.
# PDFs in the pdfs subdirectory are public and free for everyone.
UPLOAD_DIR=uploads

# SMTP: required for sending password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional overrides for the local demo seed; required for non-local databases.
# Local development defaults are documented in src/DB/seed.js and DEPLOYMENT.md.
# The seed never overwrites an existing account or password.
# Remove these values after creating the account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# Server only; checkout stays disabled until verified settlement is implemented.
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
MYFATOORAH_API_KEY=
